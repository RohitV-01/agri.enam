<script type= "text/javascript">
	var spinner = $('#loader');
	var baseUrl = $('#base_url').val();
	$(document).ready(function(){
		getStateFromNationSeed();
		getNationalData();
	});

	$(document).on('change','#min_max_state', function(){
		let stateName = $( "#min_max_state option:selected" ).text();
		$.ajax({
		    type: 'POST',
		    url: baseUrl+'Enam_ctrl/getDistrictForNationalSeed',
		    dataType: "json",
		    data: {stateName:stateName},
		    beforeSend: function(){
		    },
		    complete: function(){},
			success:function (response) {
				let x = '<option value="null">Select District</option>';
				for(let data of response){
					x+=`<option value=${data.district}>${data.district}</option>`;
				}
				$('#min_max_district').html(x);
			}
		});
	});

	// $(document).on("click", "#btnExport", function () {
         
 //        spinner.show();
 //        var element = document.getElementById('seeds_table');
	// 	var opt = {
	// 	  	margin:       1,
	// 	  	filename:     'national_seed_corporation.pdf',
	// 	  	image:        { type: 'jpeg', quality: 0.98 },
	// 	  	html2canvas:  { scale: 2 },
	// 	  	jsPDF:        { unit: 'mm', format: 'a3', orientation: 'landscape' }
	// 	};

	// 	html2pdf().set(opt).from(element).save();

	// 	setTimeout(()=>{
	// 		spinner.hide();
	// 	},3000);
    
 //    });


	function getNationalData(){
		let stateName = $( "#min_max_state option:selected" ).text();
		let distName = $( "#min_max_district option:selected" ).text();

		$.ajax({
		    type: 'POST',
		    url: baseUrl+'Enam_ctrl/getNationalSeedDataOnState',
		    dataType: "json",
		    data: {stateName:stateName, distName:distName},
		    beforeSend: function(){
		    },
		    complete: function(){},
			success:function (response) {
				let tableData = '';
				//console.log('-----------',response[0].created_at);
				$('#upload_date').html(response[0].created_at);
				for(let data of response){
					tableData+=`<tr>
									
									<td>${data.state}</td>
									<td>${data.district}</td>
									<td>${data.subDistrict}</td>
									<td>${data.dealerName}</td>
									<td>${data.dealerAdd}</td>
									<td>${data.dealerPincode}</td>
									<td>${data.dealerMobile}</td>
									<td>${data.dealerLatitude}</td>
									<td>${data.dealerLongitude}</td>
									<td>${data.areaOffName}</td>
									<td>${data.areaOffAdd}</td>
									<td>${data.areaOffPincode}</td>
									<td>${data.areaOffInchargeName}</td>
									<td>${data.areaOffInchargeEmail}</td>
									<td>${data.areaOffInchargeMobile}</td>
									<td style="text-transform: lowercase;font-size: 11px;">
									  	${getCommaSeprate(data.commodityNames)}
										
									</td>
									<td style="text-transform: lowercase;font-size: 11px;">${getCommaSeprateTest(data.hybridSeeds)}</td>
									<td style="text-transform: lowercase;font-size: 11px;">${getCommaSeprateTest(data.opSeeds)}</td>
									
									
								</tr>`;
				}

				$('#seeds_table tbody').html(tableData);
			}
		});
	}


	function getCommaSeprate(list){
		var result = "";
		var arraylist = list.split(",");
		for(let data of arraylist){
			result+= `<li class='nobull'>${data }</li>`;
		}
		return result;
	}

	function getCommaSeprateTest(list){
		var result = "";
		var arraylist = list.split(",") ;
		for(let data of arraylist){
			result+= `${data == 'No' ? `<li class='nobull' style='color:red;'>${data }</li>` : `<li class='nobull'>${data }</li>`}`;
		}
		return result;
	}

	function getStateFromNationSeed(){
		$.ajax({
		    type: 'POST',
		    url: baseUrl+'Enam_ctrl/getStateForNationalSeed',
		    dataType: "json",
		    data: {},
		    beforeSend: function(){
		    },
		    complete: function(){},
			success:function (response) {
				let x = '<option value="null">Select State</option>';
				for(let data of response){
					x+=`<option value=${data.state}>${data.state}</option>`;
				}
				$('#min_max_state').html(x);
			}
		});
	}


	function exportPdf(){
        const el = document.getElementById('testcheck');
        let divContents = el.innerHTML;
        var a = window.open('Training Feedback Data','','width=768,height=auto');
        a.document.write(
            `<html>
                <head>
                    <title>Feedback User Data</title>
                    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/css/bootstrap.min.css"/>
                    <style type="text/css">
                        table {width: 100%;font: 10px Calibri;};
                        table, th, td {border: solid 1px #DDD; border-collapse: collapse;
                            padding: 2px 3px;text-align: center;}
                        li{list-style-type: none;};
                    </style>    
                </head>
                <body onload="window.print();window.close()">
                    ${divContents} 
                </body>
            </html>`
        );
        a.document.close();
    }
	

</script>