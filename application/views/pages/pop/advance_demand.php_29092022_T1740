<script type="text/javascript">
	$('#backBtn').click(function(){
		parent.history.back();
	});


	$(document).on('click','#submitbtn',function(){
		let dropdownValue = $("#platform_list").val();
		//alert(dropdownValue);

		if(dropdownValue == 'agribazar'){
			$('#platformtable').show();
			$('#agri_data').show();
			$('#bijak_data').hide();
			$('#kisan_data').hide();
			$('#etech_data').hide();
			$('#all_data').hide();
		}

		if(dropdownValue == 'bijak'){
			$('#platformtable').show();
			$('#agri_data').hide();
			$('#bijak_data').show();
			$('#kisan_data').hide();
			$('#etech_data').hide();
			$('#all_data').hide();
		}

		if(dropdownValue == 'kisan_network'){
			$('#platformtable').show();
			$('#kisan_data').show();
			$('#agri_data').hide();
			$('#bijak_data').hide();
			$('#etech_data').hide();
			$('#all_data').hide();
		}

		if(dropdownValue == 'e_tech'){
			$('#platformtable').show();
			$('#etech_data').show();
			$('#kisan_data').hide();
			$('#agri_data').hide();
			$('#bijak_data').hide();
			$('#all_data').hide();
		}
		if(dropdownValue == 'all'){
			$('#platformtable').show();
			$('#all_data').show();
			$('#etech_data').hide();
			$('#kisan_data').hide();
			$('#agri_data').hide();
			$('#bijak_data').hide();
		}
	})




</script>

