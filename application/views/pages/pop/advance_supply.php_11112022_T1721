<script type="text/javascript">
	$('#backBtn').click(function(){
		parent.history.back();
	});


	$(document).ready(function() {
		var spinner = $('#loader');
		let startDate = document.getElementById('fromDate').value;
		let endDate = document.getElementById('toDate').value;		
		getCommodity(startDate,endDate);

		$('#backBtn').click(function(){
			parent.history.back();
		});

		$('#searchBtn').click(function(){
			spinner.show();
			let startDate = document.getElementById('fromDate').value;
			let endDate = document.getElementById('toDate').value;
			let supplyCommodity = document.getElementById('supply_commo').value;
			let supplyState = document.getElementById('supply_state').value;
			let supplyDistrict = document.getElementById('supply_district').value;
			let supplyVillage = document.getElementById('supply_village').value;
	
			$.ajax({
				url: '<?php echo base_url();?>/Enam_ctrl/getAdvanceSupplyDetails',
				method: 'POST',
				dataType:'json',
				data:{
					startDate:startDate,
					endDate:endDate,
					supplyCommodity:supplyCommodity,
					supplyState:supplyState,
					supplyDistrict:supplyDistrict,
					supplyVillage:supplyVillage,
				},
				success:function(response){
					let resData = JSON.parse(response)
					let i=1, tableData = '';

					if(resData.data.length > 0){
						spinner.hide();
						$('#no_data').css('display','none');
						$('#table_res').css('display','block');
						for(let data of resData.data){
							//console.log('after search btn click', data);
							tableData += `
									<tr>
										<td style='text-align:center;'>${i++}</td>
										<td style='text-align:center;'>${data.sellername}</td>
										<td style='text-align:center;'>${data.sellercontactno}</td>
										<td style='text-align:center;'>
										${data.expectedsupplydate.substring(0, data.expectedsupplydate.indexOf(' '))}</td>
										<td style='text-align:center;'>${data.commodity}</td>
										<td style='text-align:center;'>${data.qty}</td>
										<td style='text-align:center;'>${data.qtyuom}</td>
									</tr>`;
						}
						$('#advanceSupplyTable tbody').html(tableData);
					}else{
						spinner.hide();
						$('#table_res').css('display','none');
						$('#no_data').css('display','block');
					}
				}
			});
		});


		$('#supply_commo').change(function(){
			//spinner.show();
			let startDate = document.getElementById('fromDate').value;
			let endDate = document.getElementById('toDate').value;
			let commoId = $(this).val();
			//console.log(commoId);

			$.ajax({
				url :  '<?php echo base_url();?>/Enam_ctrl/getAdvanceSupplyState',
				type : 'POST',
				data : {
					startDate:startDate,
					endDate : endDate,
					commoId:commoId
				},
				dataType : 'json',
				success : function (response){
					if(response.status == "Success"){
						if(response.data.length > 0){
							//spinner.hide();
							let x = '<option value="">Select State</option>';
							for(let data of response.data){
								x+=`<option value=${data.state}>${data.state}</option>`
							}
							$('#supply_state').html(x)
						}
					}
				}
			});
		});

		$('#supply_state').change(function(){
			let startDate = document.getElementById('fromDate').value;
			let endDate = document.getElementById('toDate').value;
			let commoId = document.getElementById('supply_commo').value;
			let supplyState = $(this).val();

			$.ajax({
				url :  '<?php echo base_url();?>/Enam_ctrl/getAdvanceSupplyDistrict',
				type : 'POST',
				data : {
					startDate:startDate,
					endDate : endDate,
					commoId:commoId,
					supplyState:supplyState,
				},
				dataType : 'json',
				success : function (response){
					if(response.status == "Success"){
						let x = '<option value="">Select District</option>';
						for(let data of response.data){
							x+=`<option value=${data.district}>${data.district}</option>`
						}
						$('#supply_district').html(x)
					}
				}
			});
		});

		$('#supply_district').change(function(){
			let startDate = document.getElementById('fromDate').value;
			let endDate = document.getElementById('toDate').value;
			let commoId = document.getElementById('supply_commo').value;
			let supplyState = document.getElementById('supply_state').value;
			let supplyDistrict = $(this).val();
			$.ajax({
				url :  '<?php echo base_url();?>/Enam_ctrl/getAdvanceSupplyVillage',
				type : 'POST',
				data : {
					startDate:startDate,
					endDate : endDate,
					commoId:commoId,
					supplyState:supplyState,
					supplyDistrict:supplyDistrict
				},
				dataType : 'json',
				success : function (response){
					if(response.status == "Success"){
						let x = '<option value="">Select Village</option>';
						for(let data of response.data){
							x+=`<option value=${data.village}>${data.village}</option>`
						}
						$('#supply_village').html(x)
					}
				}
			});
		});

		$(document).on('change','#fromDate,#toDate',function(){
			let startDate = document.getElementById('fromDate').value;
			let endDate = document.getElementById('toDate').value;
			getCommodity(startDate,endDate);
		});
	})	

	function getCommodity(startDate, endDate){
		$.ajax({
			url :  '<?php echo base_url();?>/Enam_ctrl/getCommodity',
			type : 'POST',
			data : {
				startDate:startDate,
				endDate:endDate
			},
			dataType : 'json',
			success : function (response){
				//console.log('check commodity response', response);
				if(response.status == "Success"){
					let x = '<option value="">Select Commodity</option>';
					for(let data of response.data){
						x+=`<option value=${data.commodityid}>${data.commodity}</option>`
					}
					$('#supply_commo').html(x)
				}
			}
		});
	}



</script>