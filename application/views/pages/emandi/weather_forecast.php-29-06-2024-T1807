      function getWeatherIcon(condition) {
                let iconFileName = '';
                // Map condition to image file name
                switch (condition) {
                    case 'Partly cloudy sky':
                    iconFileName = 'sun.png';
                    break;
                    case 'Mainly Clear sky':
                    iconFileName = 'onlysun.png';
                    break;
                    case 'Mainly clear sky becoming partly cloudy towards afternoon or evening':
                    iconFileName = 'cloud.png';
                    break;
                    case 'Sunny Day':
                    iconFileName = 'onlysun.png';
                    break;
                    case 'Mainly clear sky ':
                    iconFileName = 'onlysun.png';
                    break;
                    case 'Generally cloudy sky':
                    iconFileName = 'clouds.png';
                    break;
                    case 'Overcast sky':
                    iconFileName = 'stratuscumulus.png';
                    break;
                    case 'Generally cloudy sky with Heavy rain':
                    iconFileName = 'rainy.png';
                    break;
                    // Add more cases for other conditions as needed

                    default:
                    // Use a default image if the condition doesn't match any specific cases
                    iconFileName = 'clouds.png';
                }

                // Assuming the images are located in the 'assets' folder
                return './assest/images/' + iconFileName;
                }

                        
        // Function to populate the weather forecast
       
  
     function populateWeatherForecast(weatherData) {
    var container = document.getElementById('weatherForecastContainer');

    // Clear existing content
    container.innerHTML = '';

    var row = document.createElement('div');
    row.className = 'row mt-4';

    if (weatherData.length > 0 && weatherData[0] !== null) {
        var today = weatherData[0];
        var maxTemp = Math.round(today.wfMaxTemp);
        var minTemp = Math.round(today.wfMinTemp);

        if (today.wfSunriseTime !== null) {
                var sun_rise = today.wfSunriseTime;
            } else {
                var sun_rise = '';
            }

            if (today.wfSunsetTime !== null) {
                var sun_set = today.wfSunsetTime;
            } else {
                var sun_set = '';
            }

            if (today.wfMoonriseTime !== null) {
                var moon_rise = today.wfMoonriseTime;
            } else {
                var moon_rise = '';
            }

            if (today.wfMoonsetTime !== null) {
                var moon_set = today.wfMoonsetTime;
            } else {
                var moon_set = '';
            }

            if (today.wfRelativeHumidityAt0830 !== null) {
                var wfRelativeHumidityAt_0830 = today.wfRelativeHumidityAt0830;
            } else {
                var wfRelativeHumidityAt_0830 = '';
            }

            if (today.wfRelativeHumidityAt1730 !== null) {
                var wfRelativeHumidityAt_1730 = today.wfRelativeHumidityAt1730;
            } else {
                var wfRelativeHumidityAt_1730 = '';
            }

        var todayWeatherHtml = `
            <div class="card">
                <h5 class="p-5" style="text-align: center;font-size: large;">APMC Name :- ${mandi_id}</h5>
                <div class="card-body">
                    <div class="weather-info">
                        <div class="today-weather-icon">
                            <img src="${getWeatherIcon(today.wfForecast)}" alt="Weather" class="today-weather-icon">
                        </div>
                        <div class="info-col">
                            <b>Today</b><br>
                            <b class="temperature">${maxTemp}°C</b>
                            <span class="small-text">/${minTemp}°C</span><br>
                            <b>${today.wfForecast}</b>
                        </div>
                        <div class="info-col">
                            <p><b>Humidity at 8:30 AM:</b> ${wfRelativeHumidityAt_0830}%</p>
                            <p><b>Humidity at 5:30 PM:</b> ${wfRelativeHumidityAt_1730}%</p>
                        </div>
                        <div class="info-col">
                            <p><b>Sunrise Time:</b> ${sun_rise}  &nbsp; &nbsp; &nbsp; &nbsp;<b>Sunset Time:</b> ${sun_set}</p>
                            <p></p>
                            <p><b>Moonrise Time:</b> ${moon_rise} &nbsp; &nbsp; &nbsp; &nbsp;<b>Moonset Time:</b> ${moon_set}</p>
                            <p></p>
                        </div>
                    </div>
                </div>
            </div>
        `;

        container.appendChild(createElementFromHTML(todayWeatherHtml));
    }

    var row = document.createElement('div');
    row.className = 'row';

    for (var i = 1; i < weatherData.length; i++) {
        var day = weatherData[i];

        var dayElement = document.createElement('div');
        dayElement.className = 'col-md-2 m-3';

        if (day !== null) {
            var img = document.createElement('img');
            img.src = getWeatherIcon(day.wfForecast);
            img.alt = day.wfForecast;
            img.className = 'weather-icon';

            var dayInfo = document.createElement('div');
            const timestamp = day.wfDate;
            const date = new Date(timestamp);
            const formattedDate = date.toLocaleDateString('en-US');
            var maxTemp = Math.round(today.wfMaxTemp);
            var minTemp = Math.round(today.wfMinTemp);
            const specificDate = new Date(day.wfDate); // Replace with your specific date
            const options = { day: 'numeric', month: 'numeric', year: 'numeric' };
            const formattedSpecificDate = specificDate.toLocaleDateString('en-GB', options);
           
            dayInfo.innerHTML = `
                <b>${day.day}</b><br>
                <b>${formattedSpecificDate}</b><br>
                <b class="temperature">${maxTemp}°C</b><span class="small-text">/${minTemp}°C</span><br>
                ${day.wfForecast}
            `;

            dayElement.appendChild(img);
            dayElement.appendChild(dayInfo);
        }

        row.appendChild(dayElement);
    }

    container.appendChild(row);

    function createElementFromHTML(htmlString) {
        var div = document.createElement('div');
        div.innerHTML = htmlString.trim();
        return div.firstChild;
    }

    function formatDate(dateString) {
        var date = new Date(dateString);
        return date.toDateString();
    }
}
