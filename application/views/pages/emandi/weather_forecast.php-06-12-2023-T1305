<script type="text/javascript">
	var baseUrl = $('#base_url').val();

    $.ajax({
    type: 'POST',
    url: 'https://enam.gov.in/NamWebSrv/rest/mobile/getEnrolledMandis',
    dataType: "json",
    data: {},
    beforeSend: function(){},
    complete: function(){},
    success:function (response) {
        console.log(response);
        if(response.statusMsg == 'S'){
            var x = '<option>Select State</option>';
            
            var uniqueStateNames = []; // Array to hold unique state names
            
            $.each(response.listEnrolledMandis, function(key, value) {
                if (!uniqueStateNames.includes(value.stateName)) {
                    uniqueStateNames.push(value.stateName);
                    x = x + `<option value="${value.stateName}">${value.stateName}</option>`;
                }
            });
            
            $('#today_states').html(x);
        }
        else {
            // Handle the case where response statusMsg is not 'S'
        }
    }
    });

	
    $(document).on('change', '#today_states', function() {
    var selectedStateName = $('#today_states option:selected').text();

    $.ajax({
        type: 'POST',
        url: 'https://enam.gov.in/NamWebSrv/rest/mobile/getEnrolledMandis',
        dataType: 'json',
        data: {},
        beforeSend: function() {
            $('#today_mandi').html('<option value="0">Select APMC\'s</option>');
        },
        complete: function() {},
        success: function(response) {
            console.log(response);
            if (response.statusMsg == 'S') {
                var x = '<option>Select APMC\'s</option>';

                $.each(response.listEnrolledMandis, function(key, value) {
                    if (value.stateName === selectedStateName) {
                        x = x + `<option value="${value.mandiName}">${value.mandiName}</option>`;
                    }
                });

                $('#today_mandi').html(x);
            } else {
                // Handle the case where response statusMsg is not 'S'
            }
        }
    });
    });

	    
$(document).on('change', '#today_mandi', function() {
    var state_name = $('#today_states').val();
    var mandi_id = $('#today_mandi').val();
    
    $.ajax({
        type: 'POST',
        url: 'https://enam.gov.in/NamWebSrv/rest/mobile/wheatherForeCast/getWheatherForeCast',
        dataType: 'json',
        data: {
            "wfStateName": state_name,
            "wfApmcName": mandi_id
        },
        beforeSend: function() {},
        complete: function() {},
        success: function(response) {
            if (response.wheaterForeCastModelList.length === 0) {
                $('#table_top_statename').css('display', 'none');
                $('#mandi_table').html('No record.');
            } else {
                var x = '';
                
                // Loop through the weather forecast data
                $.each(response.wheaterForeCastModelList, function(key, value) {
                    var i = 0;
                    var j = 0;
                    
                    if (i == j) {
                        $('#table_top_statename_text').html(state_name);
                        $('#table_top_statename').css('display', 'block');
                        $('#table_top_apmcname_text').html(mandi_id);
                        $('#table_top_apmcname').css('display', 'block');
                        let date = new Date().toLocaleDateString();                         
                        $('#update_date').html(date); // Set the formatted date
                        
                        
                        x = '<tr>' +
                            '<td width="10%" style="font-size:14px;padding-top:12px;">' + ' <b ><?php date_default_timezone_set("Asia/Kolkata"); echo date("D <\b\\r> m/j"); ?></b>' + '</td>' +
                            '<td td width="15%"><b style="font-size:35px">' + value.wfMaxTemp + '&deg;<small>c</small></b><span  style="font-size:15px">/' + value.wfMinTemp + '&deg;<small>c</small></span></td>' +
                            '<td style="font-size:15px;padding-top:20px;padding-left:35px">' + value.wfTodaysForecast + '</td>' +
                            '</tr>';
                        
                        $('#mandi_table').html(x);
                        $('#today_states').val('Select State');
                        $('#today_mandi').html('<option value="0">Select APMC\'s</option>');
                    }
                });
            }
        }
    });
});

	
</script>
