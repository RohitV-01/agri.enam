$(document).on('click','#contact_us_mail',function(){
			  
			 var email = $('#email').val();   
                          var con_us_name = $('#con_us_name').val();  
                           var con_us_contact = $('#con_us_contact').val(); 
                           var con_us_add =     $('#con_us_add').val();
                            var con_us_stak=     $('#con_us_stak').val();
                          var contact_desc = $('#contact_desc').val();
                         var mail_opt = $('input[name=optradio]:checked').val();
                         var cap_hide = $('#cap_hide').val();
			var cap_word = $('#cap_word').val();
                        var form_valid = true;
                        if($('#con_us_name').val() == ''){
				$('#con_us_name_error').html('Please Enter Name.').css('display','block');
				form_valid = false;
			}
		 else{
				$('#con_us_name_error').css('display','none');
			}
			if($('#con_us_contact').val() == ''){
				$('#con_us_contact_error').html('Please Enter Contact No.').css('display','block');
				form_valid = false;
			}
		 else{
				$('#con_us_contact_error').css('display','none');
			}
			if($('#con_us_add').val() == ''){
				$('#con_us_add_error').html('Please Enter Address No.').css('display','block');
				form_valid = false;
			}
		 else{
				$('#con_us_add_error').css('display','none');
			}
			if($('#contact_desc').val() == ''){
				$('#contact_desc_error').html('Please Enter Discription.').css('display','block');
				form_valid = false;
			}
		 else{
				$('#contact_desc_error').css('display','none');
			}
			if($('#con_us_stak').val() == 0){
				$('#con_us_stak_error').html('Please Select Senders Identity.').css('display','block');
				form_valid = false;
			}
		 else{
				$('#con_us_stak_error').css('display','none');
			}
			if($('#email').val() == ''){
				$('#email_error').html('Please Enter Email.').css('display','block');
				form_valid = false;
			}
		 else{
				$('#email_error').css('display','none');
			}
			 if($('#cap_word').val() == ''){
				$('#cap_word_error').html('Please Enter Captcha.').css('display','block');
				form_valid = false;
			}
		 else{
				$('#cap_word_error').css('display','none');
			}
			
			if(cap_word != cap_hide){
				$('#cap_word_error').html('Incorrect Captcha Entered Try Again.').css('display','block');
				form_valid = false;
			}
			else{
				$('#cap_word_error').css('display','none');
			}
			
			 if(form_valid){
                        
			$.ajax({
				type: 'POST',
				url: baseUrl+'/Email_ctrl/contact_mail',
				dataType: "json",
				data: {
					'email'	: email,
                    'contact_desc': contact_desc,
                    'mail_opt'  : mail_opt,
                     'con_us_name' :  con_us_name ,
                     'con_us_contact' : con_us_contact ,
                     'con_us_add'     :  con_us_add ,
                     'con_us_stak'    :  con_us_stak
				},
				beforeSend: function(){
					$('#loader').modal({'show':true});	
				},
				complete: function(){},
				success:function (response) {
                                        if(response.status = 200){
					  console.log(response);
					  $('#loader').modal('toggle');
                                           alert(response.msg);
					   location.reload();
                                        }
                                   
				}
			});
            }
});

