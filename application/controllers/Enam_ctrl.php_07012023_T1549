	function saveArrData(){
		$checkArr = $this->input->post('finalArr');
		foreach ($checkArr as $value) {
		  	$data[] = array(
		  		//'srno' =>$value['sno'],
                'state'  => $value['state'],
                'district'  => $value['dist'],
                'subDistrict'  => $value['subDist'],
                'dealerName'  => $value['dealerName'],
                'dealerAdd'  => $value['postAdd'],
                'dealerPincode'  => $value['dealPin'],
                'dealerMobile'  => $value['dealerMob'],
                'dealerLatitude'  => $value['lat'],
                'dealerLongitude'  => $value['longi'],
                'areaOffName'  => $value['offName'],
                'areaOffAdd'  => $value['offadd'],
                'areaOffPincode'  => $value['offPin'],
                'areaOffInchargeName'  => $value['offIncharge'],
                'areaOffInchargeEmail'  => $value['offEmail'],
                'areaOffInchargeMobile'  => $value['inchareMob'],
                'commodityNames'  => $value['commname'],
                'hybridSeeds'  => $value['hyseeds'],
                'opSeeds'  => $value['opseeds'],
                'created_by' => $this->session->userdata('user_id'),
                'created_at' => date('Y-m-d H:i:s')
            );
		}

		$recordCount = $this->Enam_model->getNscDataCount();

		if($recordCount > 0){
			$rtnCheck = $this->db->truncate('national_seeds_corp_info');
			if($rtnCheck > 0){
				$result = $this->db->insert_batch('national_seeds_corp_info', $data);
		        if($result){
		            echo json_encode(array('msg'=>'Insert Successfully','status'=>200));
		            die;
		        }else{
		            echo json_encode(array('msg'=>'Somthing Getting Wrong','status'=>500));
		            die;
		        }
			}
		}
	}


	function captchaForRegistrionPage(){   
      	$original_string = array_merge(range(0,9), range('a','z'), range('A', 'Z'));
 		$original_string = implode("", $original_string);
		$captcha = substr(str_shuffle($original_string), 0, 6);
		$vals = array(
			'word'          => $captcha,
			'img_path'      => './captcha/',
			'img_url'       =>  base_url().'captcha/',
			'font_path'     => FCPATH . 'captcha/font/captcha4.ttf',
			'img_width'     => '210',
			'img_height'    => 65,
			'expiration'    => 3600,
			
			//White background and border, black text
			'colors'        => array(
				'background' => array(166, 163, 162),
				'border' => array(255, 255, 255),
				'text' => array(0, 0, 0),
				'grid' => array(166, 163, 162)
			)
		);

		$cap = create_captcha($vals);
		$data['cap_image'] =  $cap['image'];
		$data['cap_word'] =  $cap['word'];
		$this->session->unset_userdata('captchaCode');
        $this->session->set_userdata('captchaCode', $data['cap_word']);
		echo json_encode(array('data'=>$data['cap_image'], 'capword' =>$data['cap_word'], 'status'=>200));
    }

