    	$original_string = array_merge(range(0,9), range('a','z'), range('A', 'Z'));
 		$original_string = implode("", $original_string);
		$captcha = substr(str_shuffle($original_string), 0, 6);
		$vals = array(
			'word'          => $captcha,
			'img_path'      => './captcha/',
			'img_url'       =>  base_url().'captcha/',
			'font_path'     => FCPATH . 'captcha/font/captcha4.ttf',
			'img_width'     => '210',
			'img_height'    => 65,
			'expiration'    => 3600,
			
			//White background and border, black text
			'colors'        => array(
				'background' => array(166, 163, 162),
				'border' => array(255, 255, 255),
				'text' => array(0, 0, 0),
				'grid' => array(160, 163, 162)
			)
		);

		$cap = create_captcha($vals);
		
		$data['cap_image'] =  $cap['image'];
		$data['cap_word'] =  $cap['word'];
		$this->session->unset_userdata('captchaCode');
        $this->session->set_userdata('captchaCode', $data['cap_word']);
		echo json_encode(array('data'=>$data['cap_image'], 'capword' =>$data['cap_word'], 'status'=>200));
    }


